# Supabase project URL, e.g. https://abcdefg.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the magic-link redirect URL. In dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Drive photo storage (server-only — never expose to the browser) ──
# Service account email from the Google Cloud JSON key file
GOOGLE_CLIENT_EMAIL=

# Private key from the same JSON key file (keep the \n escapes and quotes)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID of the Google Drive folder shared with the service account (Editor)
GOOGLE_DRIVE_FOLDER_ID=

# ── CARTO basemap API key (recommended) ──
# CARTO watermarks raster tiles without a key (since Aug 2026) and plans to
# require a key for vector tiles too. Free, no approval queue — request at
# https://carto.com/basemaps/apikey (fair use: 5M tile requests/month).
NEXT_PUBLIC_CARTO_API_KEY=